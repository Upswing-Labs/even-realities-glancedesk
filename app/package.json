{
  "name": "@upswing-labs/glancedesk-even-g2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GlanceDesk Even Realities G2 EvenHub app (576x288 4-bit green waveguide HUD, 16kHz PCM mic capture, R1 ring gestures)",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "sim": "evenhub-simulator http://localhost:5173",
    "pack:ehpk": "evenhub pack app.json dist -o glancedesk.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
